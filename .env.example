# Copy this file to .env and adjust paths for your machine.

# macOS Steam default:
ADOFAI_DIR="$HOME/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice"

# Optional overrides. Leave commented unless your setup differs.
# ADOFAI_MODS_DIR="$ADOFAI_DIR/Mods"
# ADOFAI_MANAGED="$ADOFAI_DIR/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed"

# .NET SDK location.
DOTNET_ROOT="$HOME/.dotnet"
# DOTNET_EXE="$DOTNET_ROOT/dotnet"

# Optional dependency overrides.
# UNITY_MOD_MANAGER_DLL="$ADOFAI_MANAGED/UnityModManager/UnityModManager.dll"
# HARMONY_DLL="$ADOFAI_MANAGED/UnityModManager/0Harmony.dll"

# Unity 6000.3.10f1 executable used by `./scripts/run.sh assets`.
# UNITY_EXE="/Applications/Unity/Hub/Editor/6000.3.10f1/Unity.app/Contents/MacOS/Unity"

# Optional Windows PC (OpenSSH Server + Visual Studio Build Tools with C++ x64)
# that builds and verifies the Windows in-game viewer library over SSH.
# `package` rebuilds it there; without a host it needs an up-to-date build.
# ELEMENT_WINDOWS_HOST="user@windows-pc"
# ELEMENT_WINDOWS_SSH_KEY="$HOME/.ssh/id_ed25519"
# ELEMENT_WINDOWS_REMOTE_DIR=".element/game-webview"  # per-worktree build folder on that PC
# ELEMENT_SKIP_WINDOWS_WEBVIEW=1   # package without it (Windows players lose in-game viewers)

# ElementNote inside the packages (`package` builds the macOS app itself).
# ELEMENT_WINDOWS_DMNOTE_DIR=".element/element-note"  # per-worktree build folder for `dmnote-windows-build`
# ELEMENT_DMNOTE_WINDOWS_ZIP="./ElementNote-v0.1.0-windows-x64-portable.zip"  # use a CD build instead
# ELEMENT_DMNOTE_MAC_APP="./ElementNote.app"   # use an existing macOS build instead
# ELEMENT_SKIP_DMNOTE=1      # package/install without ElementNote (players open it themselves)
# ELEMENT_PACKAGE_PLATFORMS="macos"   # package only these OSes (default: "macos windows")
# ELEMENT_INSTALL_UPDATABLE=1   # `install`/`build` leave the build able to auto-update (docs/auto-update.md)

# Build configuration for build/mod-check (default: Release).
# ELEMENT_CONFIGURATION="Debug"

# Optional output/install overrides.
# ELEMENT_BUILD_DIR="./build/Element"
# ELEMENT_INSTALL_DIR="$ADOFAI_MODS_DIR/Element"

# Optional override for the verified, committed IPC v2 bundle.
# ADOFAI_IPC_BUNDLE="$PROJECT_ROOT/vendor/adofai-ipc-runtime"
