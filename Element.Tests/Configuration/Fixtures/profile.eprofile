<?xml version="1.0" encoding="utf-8"?>
<ElementProfile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Format>1</Format>
  <ModVersion>1.2.3</ModVersion>
  <Name>Sample</Name>
  <Content>
    <SettingsVersion>9</SettingsVersion>
    <HighlightColor>HighlightColor</HighlightColor>
    <OverlayFont>OverlayFont</OverlayFont>
    <Gameplay>
      <Editor>
        <ShowAngle>true</ShowAngle>
        <ShowBeats>true</ShowBeats>
        <ShowCount>true</ShowCount>
        <ShowDuration>true</ShowDuration>
        <ExcludeLastInterval>true</ExcludeLastInterval>
        <FineRotation>true</FineRotation>
        <RotationStep>0.5</RotationStep>
        <SyncEventPositions>true</SyncEventPositions>
      </Editor>
      <Judgement>
        <Version>1</Version>
        <HidePerfect>true</HidePerfect>
        <HideXPerfect>true</HideXPerfect>
        <HideEarlyPerfect>true</HideEarlyPerfect>
        <HideLatePerfect>true</HideLatePerfect>
        <HideTooEarly>true</HideTooEarly>
        <HideEarly>true</HideEarly>
        <HideLate>true</HideLate>
        <HideTooLate>true</HideTooLate>
        <HideMiss>true</HideMiss>
        <HideOverload>true</HideOverload>
      </Judgement>
      <Planets>
        <Enabled>true</Enabled>
        <Red>
          <Enabled>true</Enabled>
          <Body>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Body>
          <Tail>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Tail>
          <Ring>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Ring>
        </Red>
        <Blue>
          <Enabled>true</Enabled>
          <Body>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Body>
          <Tail>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Tail>
          <Ring>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Ring>
        </Blue>
        <Green>
          <Enabled>true</Enabled>
          <Body>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Body>
          <Tail>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Tail>
          <Ring>
            <OverrideColor>true</OverrideColor>
            <ColorHex>ColorHex</ColorHex>
            <Opacity>0.5</Opacity>
          </Ring>
        </Green>
      </Planets>
      <Chatter>
        <Enabled>true</Enabled>
        <WindowMs>1</WindowMs>
        <IgnoredKeys>
          <KeyCode>F24</KeyCode>
        </IgnoredKeys>
      </Chatter>
    </Gameplay>
    <Effects>
      <DefaultsVersion>1</DefaultsVersion>
      <Enabled>true</Enabled>
      <ActivePresetId>ActivePresetId</ActivePresetId>
      <Presets>
        <EffectPreset>
          <Id>Id</Id>
          <Name>Name</Name>
          <Effects>Checkpoints</Effects>
          <CameraZoom>1</CameraZoom>
          <ShortcutKey>F24</ShortcutKey>
          <ShortcutModifier>F24</ShortcutModifier>
        </EffectPreset>
      </Presets>
    </Effects>
    <OverlayLayouts>
      <OverlayLayoutSettings>
        <Id>Id</Id>
        <TemplateId>TemplateId</TemplateId>
        <Enabled>true</Enabled>
        <Customized>true</Customized>
        <CenterX>0.5</CenterX>
        <CenterY>0.5</CenterY>
        <Scale>0.5</Scale>
        <LayoutVersion>1</LayoutVersion>
        <Anchor>BottomRight</Anchor>
        <OffsetX>0.5</OffsetX>
        <OffsetY>0.5</OffsetY>
        <GrowFrom>Auto</GrowFrom>
        <DefaultPlacement>DefaultPlacement</DefaultPlacement>
        <PendingGroup>PendingGroup</PendingGroup>
        <Text>
          <Runs>
            <OverlayTextRun>
              <Text>Text</Text>
              <Value>Value</Value>
              <Color>
                <Highlight>true</Highlight>
                <Hex>Hex</Hex>
                <Alpha>0.5</Alpha>
                <AlphaFormula>AlphaFormula</AlphaFormula>
                <Gradient>
                  <Kind>Diamond</Kind>
                  <Stops>
                    <OverlayGradientStop>
                      <Position>0.5</Position>
                      <PositionFormula>PositionFormula</PositionFormula>
                      <Hex>Hex</Hex>
                      <Alpha>0.5</Alpha>
                      <AlphaFormula>AlphaFormula</AlphaFormula>
                    </OverlayGradientStop>
                  </Stops>
                  <StartX>0.5</StartX>
                  <StartY>0.5</StartY>
                  <EndX>0.5</EndX>
                  <EndY>0.5</EndY>
                  <WidthX>0.5</WidthX>
                  <WidthY>0.5</WidthY>
                  <AngleFormula>AngleFormula</AngleFormula>
                </Gradient>
              </Color>
              <Size>0.5</Size>
              <SizeFormula>SizeFormula</SizeFormula>
              <Font>Font</Font>
              <Animate>true</Animate>
            </OverlayTextRun>
          </Runs>
        </Text>
        <Shape>
          <Kind>Circle</Kind>
          <Width>0.5</Width>
          <Height>0.5</Height>
          <Points>
            <OverlayShapePoint>
              <X>0.5</X>
              <Y>0.5</Y>
              <Radius>0.5</Radius>
              <RadiusFormula>RadiusFormula</RadiusFormula>
            </OverlayShapePoint>
          </Points>
          <Fill>
            <Highlight>true</Highlight>
            <Hex>Hex</Hex>
            <Alpha>0.5</Alpha>
            <AlphaFormula>AlphaFormula</AlphaFormula>
            <Gradient>
              <Kind>Diamond</Kind>
              <Stops>
                <OverlayGradientStop>
                  <Position>0.5</Position>
                  <PositionFormula>PositionFormula</PositionFormula>
                  <Hex>Hex</Hex>
                  <Alpha>0.5</Alpha>
                  <AlphaFormula>AlphaFormula</AlphaFormula>
                </OverlayGradientStop>
              </Stops>
              <StartX>0.5</StartX>
              <StartY>0.5</StartY>
              <EndX>0.5</EndX>
              <EndY>0.5</EndY>
              <WidthX>0.5</WidthX>
              <WidthY>0.5</WidthY>
              <AngleFormula>AngleFormula</AngleFormula>
            </Gradient>
          </Fill>
          <Stroke>
            <Highlight>true</Highlight>
            <Hex>Hex</Hex>
            <Alpha>0.5</Alpha>
            <AlphaFormula>AlphaFormula</AlphaFormula>
            <Gradient>
              <Kind>Diamond</Kind>
              <Stops>
                <OverlayGradientStop>
                  <Position>0.5</Position>
                  <PositionFormula>PositionFormula</PositionFormula>
                  <Hex>Hex</Hex>
                  <Alpha>0.5</Alpha>
                  <AlphaFormula>AlphaFormula</AlphaFormula>
                </OverlayGradientStop>
              </Stops>
              <StartX>0.5</StartX>
              <StartY>0.5</StartY>
              <EndX>0.5</EndX>
              <EndY>0.5</EndY>
              <WidthX>0.5</WidthX>
              <WidthY>0.5</WidthY>
              <AngleFormula>AngleFormula</AngleFormula>
            </Gradient>
          </Stroke>
          <StrokeWidth>0.5</StrokeWidth>
          <WidthFormula>WidthFormula</WidthFormula>
          <HeightFormula>HeightFormula</HeightFormula>
          <StrokeWidthFormula>StrokeWidthFormula</StrokeWidthFormula>
        </Shape>
        <Mod>
          <Data>Data</Data>
          <Width>0.5</Width>
          <Height>0.5</Height>
          <KoreanName>KoreanName</KoreanName>
          <EnglishName>EnglishName</EnglishName>
        </Mod>
      </OverlayLayoutSettings>
    </OverlayLayouts>
  </Content>
</ElementProfile>
