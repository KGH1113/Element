{
  "identifier": "element-note-dev",
  "description": "Dev server capability (remote URLs are added at runtime by register_dev_capability)",
  "local": true,
  "windows": ["main", "hand-overlay", "foot-overlay"],
  "webviews": ["main", "hand-overlay", "foot-overlay"],
  "permissions": [
    "element-note-allow-all",
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
