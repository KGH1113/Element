{
  "name": "@impl-resourcepack/impl-dm-note",
  "version": "0.1.0",
  "description": "ImplDmNote desktop key viewer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "check": "npm run sdk:check && npm run type-check && npm run lint && npm run format:check && npm run test",
    "type-check:watch": "tsc --noEmit --watch",
    "tauri:dev": "tauri dev -f asio-backend",
    "tauri:dev:no-asio": "tauri dev",
    "tauri:dev:edge-beta": "node scripts/run-with-edge-beta.cjs",
    "webview2:download:143": "node scripts/download-webview2-fixed-runtime.cjs --major 143 --arch x64",
    "tauri:dev:webview2-fixed:143": "npm run webview2:download:143 && tauri dev -f asio-backend",
    "tauri:build": "node scripts/build-platform.cjs",
    "tauri:build:mac": "tauri build --bundles app -f asio-backend && node scripts/sign-macos-app.mjs",
    "tauri:build:windows": "node scripts/build-portable-win.cjs --major 143 --arch x64",
    "tauri:build:portable:webview2-fixed:143": "node scripts/build-portable-win.cjs --major 143 --arch x64",
    "//": "버전 업데이트: patch(1.4.0->1.4.1), minor(1.4.0->1.5.0), major(1.4.0->2.0.0)",
    "sync-version": "node scripts/sync-version.cjs",
    "licenses:generate": "node scripts/generate-third-party-licenses.cjs",
    "licenses:check": "node scripts/generate-third-party-licenses.cjs --check",
    "version": "npm run sync-version && git add package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml",
    "test": "vitest run && node --test scripts/*.test.cjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sdk:check": "node scripts/verify-vendored-sdk.cjs"
  },
  "contributors": [
    {
      "name": "lee-sihun",
      "role": "Developer",
      "url": "https://github.com/lee-sihun"
    },
    {
      "name": "yeonu-me",
      "role": "Designer",
      "url": "https://github.com/yeonu-me"
    }
  ],
  "author": "KGH1113",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@preact/signals-react": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "~2.11.4",
    "@types/node": "^22.15.27",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.1.5",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@floating-ui/react": "^0.27.16",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "~2.11.1",
    "htm": "^3.1.1",
    "lenis": "^1.3.15",
    "ogl": "^1.0.11",
    "react": "^19.2.4",
    "react-color-palette": "^7.3.1",
    "react-dom": "^19.2.4",
    "three": "^0.180.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.3"
  }
}
